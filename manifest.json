{
   "manifest_version": 3,
   "name": "Clipo",
   "version": "1.2",
   "description": "Pop out video player.",
   "icons": {
      "128": "assets/icon.png"
   },
   "action": {
      "default_icon": {
         "19": "assets/icon.png",
         "38": "assets/icon.png"
      }
   },
   "background": {
      "service_worker": "src/background.js"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "mac": "Alt+P",
            "windows": "Alt+P",
            "chromeos": "Alt+P",
            "linux": "Alt+P"
         }
      }
   },
   "permissions": [
      "scripting"
   ],
   "host_permissions": [
      "<all_urls>"
   ],
   "content_scripts": [
      {
         "matches": [
            "<all_urls>"
         ],
         "js": [
            "src/content.js"
         ],
         "all_frames": true
      }
   ],
   "web_accessible_resources": [
      {
         "resources": [
            "assets/icon.png"
         ],
         "matches": [
            "<all_urls>"
         ]
      }
   ]
}